# Local development database - using SQLite or local PostgreSQL
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/sk_media

# Server port (Frontend)
PORT=5173

# Frontend base path
BASE_PATH=/

# Session secret - use any random long string for development
SESSION_SECRET=your-local-dev-secret-key-change-this-in-production-12345

# Admin credentials
ADMIN_USERNAME=skadmin
ADMIN_INITIAL_PASSWORD=Admin@123456

# SMTP settings - using Mailtrap or Gmail for testing
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=test@example.com
SMTP_PASSWORD=test_password
SMTP_FROM=noreply@skmonetization.local

# Optional site URL
VITE_SITE_URL=http://localhost:5173

