# Replit supplies DATABASE_URL for the built-in PostgreSQL database.
DATABASE_URL=

# Set SESSION_SECRET in Replit Secrets. Use a long, random value.
SESSION_SECRET=

# The first admin is created once when the API starts and no admin exists.
ADMIN_USERNAME=skadmin
ADMIN_INITIAL_PASSWORD=

# SMTP credentials are used by Nodemailer to notify the business inbox.
# SMTP_FROM is optional and defaults to SMTP_USER.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional public origin; set to the published URL to emit canonical and og:url tags.
VITE_SITE_URL=
